{
  "manifest_version": 3,
  "name": "Skimline",
  "version": "0.5.1",
  "key": "",
  "minimum_chrome_version": "114",
  "description": "Skim any long YouTube video into a scannable, jump-anywhere map of its ideas.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "sidePanel"],
  "host_permissions": ["https://*.youtube.com/*", "https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["caption-utils.js", "ui-utils.js", "transcript-utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Skimline",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
